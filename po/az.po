#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:9 data/gsettings/org.gnome.shotwell.gschema.xml:442
msgid "OAuth Access Phase Token"
msgstr "OAuth Giriş Mərhələsi Tokeni"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:10
msgid "The authorization token for the currently logged in Tumblr user, if any"
msgstr "Hazırda daxil olmuş Tumblr istifadəçisi üçün səlahiyətləndirmə tokeni (əgər varsa)"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:15 data/gsettings/org.gnome.shotwell.gschema.xml:448
msgid "OAuth Access Phase Token Secret"
msgstr "OAuth Giriş Mərhələsi Token Sirri"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:16
msgid "The cryptographic secret used to sign requests against the authorization token for the currently logged in Tumblr user, if any"
msgstr "Hazırda daxil olmuş Tumblr istifadəçisi üçün səlahiyətləndirmə tokeninə qarşı sorğuları imzalamaq üçün istifadə olunan kriptoqrafik sirr (əgər varsa)"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:21 data/gsettings/org.gnome.shotwell.gschema.xml:454 data/gsettings/org.gnome.shotwell.gschema.xml:512 data/gsettings/org.gnome.shotwell.gschema.xml:574
msgid "username"
msgstr "istifadəçi adı"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:22 data/gsettings/org.gnome.shotwell.gschema.xml:455
msgid "The user name of the currently logged in Flickr user, if any"
msgstr "Hazırda daxil olmuş Flickr istifadəçisinin istifadəçi adı (əgər varsa)"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:27 data/gsettings/org.gnome.shotwell.gschema.xml:486
msgid "default size"
msgstr "varsayılan ölçü"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:28
msgid "A numeric code representing the default size for photos uploaded to Tumblr"
msgstr "Tumblr-a yüklənən fotolar üçün varsayılan ölçünü təmsil edən rəqəmsal kod"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:33
msgid "default blog"
msgstr "varsayılan bloq"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:34
msgid "The name of the default blog of the user, if any"
msgstr "İstifadəçinin varsayılan bloqunun adı (əgər varsa)"

#: data/gsettings/org.gnome.shotwell.gschema.xml:25
msgid "display basic properties"
msgstr "əsas xüsusiyyətləri göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:26
msgid "True if the basic properties pane is to be displayed, false otherwise"
msgstr "Əgər əsas xüsusiyyətlər paneli göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:31
msgid "display extended properties"
msgstr "genişləndirilmiş xüsusiyyətləri göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:32
msgid "True if the extended properties window is to be displayed, false otherwise"
msgstr "Əgər genişləndirilmiş xüsusiyyətlər pəncərəsi göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:37
msgid "display sidebar"
msgstr "yan paneli göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:38
msgid "True if the sidebar is to be displayed, false otherwise"
msgstr "Əgər yan panel göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:43
msgid "display toolbar"
msgstr "alət çubuğunu göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:44
msgid "True if the bottom toolbar is to be displayed, false otherwise"
msgstr "Əgər aşağıdakı alət çubuğu göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:49
msgid "display map widget"
msgstr "xəritə vidcetini göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:50
msgid "True if the map widget is to be displayed, false otherwise"
msgstr "Əgər xəritə vidceti göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:55
msgid "display search bar"
msgstr "axtarış çubuğunu göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:56
msgid "True if the Search/Filter Toolbar is to be displayed, false otherwise"
msgstr "Əgər axtarış/süzgəc alət çubuğu göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:61
msgid "display photo titles"
msgstr "foto başlıqlarını göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:62
msgid "True if photo titles are to be displayed beneath thumbnails in collection views, false otherwise"
msgstr "Əgər kolleksiya görünüşündə kiçik şəkillərin altında foto başlıqları göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:67
msgid "display photo comments"
msgstr "foto rəylərini göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:68
msgid "True if photo comments are to be displayed beneath thumbnails in collection views, false otherwise"
msgstr "Əgər kolleksiya görünüşündə kiçik şəkillərin altında foto rəyləri göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:73
msgid "display event comments"
msgstr "hadisə rəylərini göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:74
msgid "True if event comments are to be displayed beneath thumbnails in event views, false otherwise"
msgstr "Əgər hadisə görünüşündə kiçik şəkillərin altında hadisə rəyləri göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:79
msgid "display photo tags"
msgstr "foto teqlərini göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:80
msgid "True if photo tags are to be listed beneath thumbnails in collection views, false otherwise"
msgstr "Əgər kolleksiya görünüşündə kiçik şəkillərin altında foto teqləri göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:85
msgid "display photo ratings"
msgstr "foto qiymətləndirmələrini göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:86
msgid "True if a photo’s rating should be displayed as overlaid trinket, false otherwise"
msgstr "Əgər fotonun qiyməti üst-üstə işarə kimi göstərilməlidirsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:91
msgid "rating filter level"
msgstr "qiymətləndirmə süzgəc səviyyəsi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:92
msgid "Determines how to filter photos based on their ratings. 1: Rejected or better, 2: Unrated or better, 3: One or better, 4: Two or better, 5: Three or better, 6: Four or better, 7: Five or better"
msgstr ""
"Fotoların qiymətləndirmələrinə görə necə süzüləcəyini müəyyən edir. 1: Rədd edilmiş və ya daha yaxşı, 2: Qiymətləndirilməmiş və ya daha yaxşı, 3: Bir və ya daha yaxşı, 4: İki və ya daha yaxşı, 5: Üç və ya daha "
"yaxşı, 6: Dörd və ya daha yaxşı, 7: Beş və ya daha yaxşı"

#: data/gsettings/org.gnome.shotwell.gschema.xml:97
msgid "sort events ascending"
msgstr "hadisələri artan sıralama"

#: data/gsettings/org.gnome.shotwell.gschema.xml:98
msgid "True if events should be sorted ascending, false if descending"
msgstr "Əgər hadisələr artan qaydada sıralanmalıdırsa doğrudur, azalan qaydada olmalıdırsa yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:103
msgid "sort library photos ascending"
msgstr "kitabxana fotolarını artan sıralama"

#: data/gsettings/org.gnome.shotwell.gschema.xml:104
msgid "True if library photos should be sorted ascending, false if descending"
msgstr "Əgər kitabxana fotoları artan qaydada sıralanmalıdırsa doğrudur, azalan qaydada olmalıdırsa yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:109
msgid "sort library photos criteria"
msgstr "kitabxana fotolarının sıralama meyarı"

#: data/gsettings/org.gnome.shotwell.gschema.xml:110
msgid "A numeric code that specifies the sort criteria for photos in library views"
msgstr "Kitabxana görünüşlərində fotolar üçün sıralama meyarını göstərən rəqəmsal kod"

#: data/gsettings/org.gnome.shotwell.gschema.xml:115
msgid "sort event photos ascending"
msgstr "hadisə fotolarını artan sıralama"

#: data/gsettings/org.gnome.shotwell.gschema.xml:116
msgid "True if event photos should be sorted ascending, false if descending"
msgstr "Əgər hadisə fotoları artan qaydada sıralanmalıdırsa doğrudur, azalan qaydada olmalıdırsa yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:121
msgid "sort event photos criteria"
msgstr "hadisə fotolarının sıralama meyarı"

#: data/gsettings/org.gnome.shotwell.gschema.xml:122
msgid "Specifies the sort criteria for event photos"
msgstr "Hadisə fotoları üçün sıralama meyarını göstərir"

#: data/gsettings/org.gnome.shotwell.gschema.xml:127
msgid "use 24 hour time"
msgstr "24 saatlıq zamanı istifadə et"

#: data/gsettings/org.gnome.shotwell.gschema.xml:128
msgid "True if should display times with a 24 hour clock, false if times should use AM/PM notation"
msgstr "Əgər zaman 24 saatlıq formatda göstərilməlidirsə doğrudur, əks halda AM/PM qeydindən istifadə olunacaq"

#: data/gsettings/org.gnome.shotwell.gschema.xml:133
msgid "keep relative time between photos"
msgstr "fotolar arasında nisbi zamanı saxla"

#: data/gsettings/org.gnome.shotwell.gschema.xml:134
msgid "True if when adjusting time/date of photos, relative time should be maintained. False if all photos should be set to the same time"
msgstr "Əgər fotoların tarix/zamanı tənzimlənərkən nisbi zaman saxlanmalıdırsa doğrudur, bütün fotolar eyni zamana qoyulmalıdırsa yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:139
msgid "modify original photo files"
msgstr "orijinal foto fayllarını dəyiş"

#: data/gsettings/org.gnome.shotwell.gschema.xml:140
msgid "True if when adjusting time/date of photos, the original files should be modified as well. False if changes are made only in the database"
msgstr "Əgər fotoların tarix/zamanı tənzimlənərkən orijinal fayllar da dəyişdirilməlidirsə doğrudur, yalnız verilənlər bazasında dəyişiklik edilirsə yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:145
msgid "show welcome dialog on startup"
msgstr "başlanğıcda xoş gəldiniz dialoqunu göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:146
msgid "True if, when on startup, a welcome dialog should be shown. False if it should not be shown"
msgstr "Əgər başlanğıcda xoş gəldiniz dialoqu göstərilməlidirsə doğrudur, göstərilməməlidirsə yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:151
msgid "sidebar position"
msgstr "yan panelin mövqeyi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:152
msgid "The width, in pixels, of the sidebar"
msgstr "Yan panelin eni (piksel ilə)"

#: data/gsettings/org.gnome.shotwell.gschema.xml:157
msgid "photo thumbnail scale"
msgstr "foto miniatür miqyası"

#: data/gsettings/org.gnome.shotwell.gschema.xml:158
msgid "The scale of photo thumbnails, ranging from 72 to 360"
msgstr "Foto miniatürlərinin miqyası (72-dən 360-a qədər)"

#: data/gsettings/org.gnome.shotwell.gschema.xml:163
msgid "pin toolbar state"
msgstr "alət çubuğunun sabitlənmə vəziyyəti"

#: data/gsettings/org.gnome.shotwell.gschema.xml:164
msgid "Pin toolbar in fullscreen, or not"
msgstr "Alət çubuğunu tam ekran rejimində sabitləmək və ya sabitləməmək"

#: data/gsettings/org.gnome.shotwell.gschema.xml:169
msgid "prefer GTK+’s dark theme"
msgstr "GTK+ qaranlıq üslubunu üstün tut"

#: data/gsettings/org.gnome.shotwell.gschema.xml:170
msgid "Whether to use the dark theme of GTK+ for Shotwell or not"
msgstr "Shotwell üçün GTK+ qaranlıq üslubunun istifadə olunub-olunmaması"

#: data/gsettings/org.gnome.shotwell.gschema.xml:175
msgid "background for transparent images"
msgstr "şəffaf şəkillər üçün arxa fon"

#: data/gsettings/org.gnome.shotwell.gschema.xml:176
msgid "The background to use for transparent images"
msgstr "Şəffaf şəkillər üçün istifadə olunacaq arxa fon"

#: data/gsettings/org.gnome.shotwell.gschema.xml:181
msgid "color for solid transparency background"
msgstr "bərk şəffaflıq arxa fonu üçün rəng"

#: data/gsettings/org.gnome.shotwell.gschema.xml:182
msgid "Color to use if background for transparent images is set to solid color"
msgstr "Əgər şəffaf şəkillər üçün arxa fon düz rəng seçilərsə istifadə olunacaq rəng"

#: data/gsettings/org.gnome.shotwell.gschema.xml:187
msgid "Selection state of “hide photos” option"
msgstr "“fotoları gizlət” seçiminin seçim vəziyyəti"

#: data/gsettings/org.gnome.shotwell.gschema.xml:188
msgid "Last used selection state of the “hide photos already imported” option in the import page"
msgstr "İdxal səhifəsində “artıq idxal edilmiş fotoları gizlət” seçiminin sonuncu istifadə vəziyyəti"

#: data/gsettings/org.gnome.shotwell.gschema.xml:195
msgid "duration"
msgstr "müddət"

#: data/gsettings/org.gnome.shotwell.gschema.xml:196
msgid "The time (in seconds) to show each photo in the slideshow"
msgstr "Slayd-şouda hər bir fotonun göstərilmə müddəti (saniyə ilə)"

#: data/gsettings/org.gnome.shotwell.gschema.xml:201
msgid "transition duration"
msgstr "keçid müddəti"

#: data/gsettings/org.gnome.shotwell.gschema.xml:202
msgid "The time (in seconds) that a transition runs between photos in a slideshow"
msgstr "Slayd-şouda fotolar arasında keçidin davametmə müddəti (saniyə ilə)"

#: data/gsettings/org.gnome.shotwell.gschema.xml:207
msgid "transition effect id"
msgstr "keçid effekti id-si"

#: data/gsettings/org.gnome.shotwell.gschema.xml:208
msgid "The time (in seconds) to show each transition between photos in a slideshow"
msgstr "Slayd-şouda fotolar arasındakı hər keçidin göstərilmə müddəti (saniyə ilə)"

#: data/gsettings/org.gnome.shotwell.gschema.xml:213
msgid "Show title"
msgstr "Başlığı göstər"

#: data/gsettings/org.gnome.shotwell.gschema.xml:214
msgid "Whether to show the title of a photo during the slideshow"
msgstr "Slayd-şou zamanı fotonun başlığının göstərilib-göstərilməməsi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:219 data/ui/slideshow_settings.ui:78
msgid "Shuffle"
msgstr "Qarışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:220
msgid "Whether to shuffle the order of photos during the slideshow"
msgstr "Slayd-şou zamanı fotoların qarışıq qaydada göstərilib-göstərilməməsi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:227
msgid "maximize library window"
msgstr "kitabxana pəncərəsini böyüt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:228
msgid "True if library application is maximized, false otherwise"
msgstr "Əgər kitabxana tətbiqi böyüdülübsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:233
msgid "width of library window"
msgstr "kitabxana pəncərəsinin eni"

#: data/gsettings/org.gnome.shotwell.gschema.xml:234
msgid "The last recorded width of the library application window"
msgstr "Kitabxana tətbiqi pəncərəsinin son qeydə alınmış eni"

#: data/gsettings/org.gnome.shotwell.gschema.xml:239
msgid "height of library window"
msgstr "kitabxana pəncərəsinin hündürlüyü"

#: data/gsettings/org.gnome.shotwell.gschema.xml:240
msgid "The last recorded height of the library application window"
msgstr "Kitabxana tətbiqi pəncərəsinin son qeydə alınmış hündürlüyü"

#: data/gsettings/org.gnome.shotwell.gschema.xml:245
msgid "maximize direct-edit window"
msgstr "birbaşa redaktə pəncərəsini böyüt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:246
msgid "True if direct-edit application is maximized, false otherwise"
msgstr "Əgər birbaşa redaktə tətbiqi böyüdülübsə doğrudur, əks halda yanlışdır"

#: data/gsettings/org.gnome.shotwell.gschema.xml:251
msgid "width of direct-edit window"
msgstr "birbaşa redaktə pəncərəsinin eni"

#: data/gsettings/org.gnome.shotwell.gschema.xml:252
msgid "The last recorded width of the direct-edit application window"
msgstr "Birbaşa redaktə tətbiqi pəncərəsinin son qeydə alınmış eni"

#: data/gsettings/org.gnome.shotwell.gschema.xml:257
msgid "height of direct-edit window"
msgstr "birbaşa redaktə pəncərəsinin hündürlüyü"

#: data/gsettings/org.gnome.shotwell.gschema.xml:258
msgid "The last recorded height of the direct-edit application window"
msgstr "Birbaşa redaktə tətbiqi pəncərəsinin son qeydə alınmış hündürlüyü"

#: data/gsettings/org.gnome.shotwell.gschema.xml:263
msgid "sidebar divider position"
msgstr "yan panel bölücüsünün mövqeyi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:264
msgid "The last recorded position of the divider between the sidebar and view in library application window"
msgstr "Kitabxana tətbiqi pəncərəsində yan panel ilə görünüş arasındakı bölücünün son qeydə alınmış mövqeyi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:271
msgid "import directory"
msgstr "idxal qovluğu"

#: data/gsettings/org.gnome.shotwell.gschema.xml:272
msgid "Directory in which imported photo files are placed"
msgstr "İdxal edilmiş foto fayllarının yerləşdirildiyi qovluq"

#: data/gsettings/org.gnome.shotwell.gschema.xml:277
msgid "watch library directory for new files"
msgstr "kitabxana qovluğunu yeni fayllar üçün izləmək"

#: data/gsettings/org.gnome.shotwell.gschema.xml:278
msgid "If true, files added to the library directory are automatically imported"
msgstr "Əgər doğrudursa, kitabxana qovluğuna əlavə edilən fayllar avtomatik idxal ediləcək"

#: data/gsettings/org.gnome.shotwell.gschema.xml:283
msgid "write metadata to master files"
msgstr "metadatanı əsas fayllara yaz"

#: data/gsettings/org.gnome.shotwell.gschema.xml:284
msgid "If true, changes to metadata (tags, titles, etc.) are written to the master photo file"
msgstr "Əgər doğrudursa, metadata (teqlər, başlıqlar və s.) dəyişiklikləri əsas foto faylına yazılacaq"

#: data/gsettings/org.gnome.shotwell.gschema.xml:289
msgid "use lowercase filenames"
msgstr "fayl adlarını kiçik hərflə istifadə et"

#: data/gsettings/org.gnome.shotwell.gschema.xml:290
msgid "If true, Shotwell will convert all filenames to lowercase when importing photo files"
msgstr "Əgər doğrudursa, Shotwell foto faylları idxal edərkən bütün fayl adlarını kiçik hərflərə çevirəcək"

#: data/gsettings/org.gnome.shotwell.gschema.xml:295
msgid "directory pattern"
msgstr "qovluq naxışı"

#: data/gsettings/org.gnome.shotwell.gschema.xml:296
msgid "A string encoding a naming pattern that will be used to name photo directories on import"
msgstr "İdxal zamanı foto qovluqlarının adlandırılması üçün istifadə olunacaq ad naxışını kodlayan sətir"

#: data/gsettings/org.gnome.shotwell.gschema.xml:301
msgid "directory pattern custom"
msgstr "fərdi qovluq naxışı"

#: data/gsettings/org.gnome.shotwell.gschema.xml:302
msgid "A string encoding a custom naming pattern that will be used to name photo directories on import"
msgstr "İdxal zamanı foto qovluqlarını adlandırmaq üçün istifadə olunacaq fərdi ad naxışını kodlayan sətir"

#: data/gsettings/org.gnome.shotwell.gschema.xml:307
msgid "RAW developer default"
msgstr "RAW inkişafçı varsayılanı"

#: data/gsettings/org.gnome.shotwell.gschema.xml:308
msgid "Default option for which RAW developer Shotwell will use"
msgstr "Shotwell-in istifadə edəcəyi RAW inkişafçısı üçün varsayılan seçim"

#: data/gsettings/org.gnome.shotwell.gschema.xml:315
msgid "Most-recently-used crop aspect ratio menu choice"
msgstr "Ən son istifadə olunmuş kəsim nisbəti menyu seçimi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:316
msgid "A numeric code representing the last crop menu choice the user made"
msgstr "İstifadəçinin sonuncu kəsim menyu seçimindən ibarət rəqəmsal kod"

#: data/gsettings/org.gnome.shotwell.gschema.xml:320
msgid "Most-recently-used crop custom aspect ratio’s numerator"
msgstr "Ən son istifadə olunmuş fərdi kəsim nisbətinin surəti"

#: data/gsettings/org.gnome.shotwell.gschema.xml:321
msgid "A nonzero, positive integer representing the width part of the last custom crop ratio the user entered"
msgstr "İstifadəçinin daxil etdiyi sonuncu fərdi kəsim nisbətinin en hissəsini təmsil edən müsbət, sıfır olmayan tam ədəd"

