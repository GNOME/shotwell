#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:6
#: data/gsettings/org.gnome.shotwell.gschema.xml:438
msgid "OAuth Access Phase Token"
msgstr "OAuth-tilgangsfase-token"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:7
msgid "The authorization token for the currently logged in Tumblr user, if any"
msgstr "Autorisasjonstokenet for den innlogga Tumblr-brukaren, om det finst"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:12
#: data/gsettings/org.gnome.shotwell.gschema.xml:444
msgid "OAuth Access Phase Token Secret"
msgstr "Løyndom for OAuth-tilgangsfasetoken"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:13
msgid ""
"The cryptographic secret used to sign requests against the authorization "
"token for the currently logged in Tumblr user, if any"
msgstr ""
"Den kryptografiske løyndomen som vert brukt til å signere førespurnader mot "
"autorisasjonstokenet for den innlogga Tumblr-brukaren, om det finst"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:18
#: data/gsettings/org.gnome.shotwell.gschema.xml:450
#: data/gsettings/org.gnome.shotwell.gschema.xml:508
#: data/gsettings/org.gnome.shotwell.gschema.xml:570
msgid "username"
msgstr "brukarnamn"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:19
#: data/gsettings/org.gnome.shotwell.gschema.xml:451
msgid "The user name of the currently logged in Flickr user, if any"
msgstr "Brukarnamnet til den Flickr-brukaren som er logga inn, viss det finst"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:24
#: data/gsettings/org.gnome.shotwell.gschema.xml:482
msgid "default size"
msgstr "standard storleik"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:25
msgid ""
"A numeric code representing the default size for photos uploaded to Tumblr"
msgstr ""
"Ein numerisk kode som representerer standardstorleiken for bilete opplasta "
"til Tumblr"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:30
msgid "default blog"
msgstr "standard blogg"

#: data/gsettings/org.gnome.shotwell-extras.gschema.xml:31
msgid "The name of the default blog of the user, if any"
msgstr "Namnet på brukaren sin standardblogg, viss det finst"

#: data/gsettings/org.gnome.shotwell.gschema.xml:22
msgid "display basic properties"
msgstr "vis grunnleggjande eigenskapar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:23
msgid "True if the basic properties pane is to be displayed, false otherwise"
msgstr "Sann viss panelet med grunneigenskapar skal visast, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:28
msgid "display extended properties"
msgstr "vis utvida eigenskapar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:29
msgid ""
"True if the extended properties window is to be displayed, false otherwise"
msgstr "Sann viss utvida eigenskapar-vindauget skal visast, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:34
msgid "display sidebar"
msgstr "vis sidefelt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:35
msgid "True if the sidebar is to be displayed, false otherwise"
msgstr "Sann viss sidefeltet skal visast, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:40
msgid "display toolbar"
msgstr "vis verktøylinje"

#: data/gsettings/org.gnome.shotwell.gschema.xml:41
msgid "True if the bottom toolbar is to be displayed, false otherwise"
msgstr "Sann viss den nedre verktøylinja skal visast, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:46
msgid "display map widget"
msgstr "vis kartkomponent"

#: data/gsettings/org.gnome.shotwell.gschema.xml:47
msgid "True if the map widget is to be displayed, false otherwise"
msgstr "Sann viss kartkomponenten skal visast, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:52
msgid "display search bar"
msgstr "vis søkefelt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:53
msgid "True if the Search/Filter Toolbar is to be displayed, false otherwise"
msgstr "Sann viss Søk/filter-verktøylinja skal visast, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:58
msgid "display photo titles"
msgstr "vis bilettitlar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:59
msgid ""
"True if photo titles are to be displayed beneath thumbnails in collection "
"views, false otherwise"
msgstr ""
"Sann viss bilettitlar skal visast under miniatyrbilete i samlingar, usann "
"elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:64
msgid "display photo comments"
msgstr "vis kommentarar til biletet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:65
msgid ""
"True if photo comments are to be displayed beneath thumbnails in collection "
"views, false otherwise"
msgstr ""
"Sann viss kommentarar til biletet skal visast under miniatyrbiletet i "
"samlingar, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:70
msgid "display event comments"
msgstr "vis hendingskommentarar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:71
msgid ""
"True if event comments are to be displayed beneath thumbnails in event "
"views, false otherwise"
msgstr ""
"Sann viss hendingskommentarar skal visast under miniatyrbilete i "
"hendingsvisingar, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:76
msgid "display photo tags"
msgstr "vis merkelappar på bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:77
msgid ""
"True if photo tags are to be listed beneath thumbnails in collection views, "
"false otherwise"
msgstr ""
"Sann viss merkelappar for bilete skal listast under miniatyrbilete i "
"samlingar, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:82
msgid "display photo ratings"
msgstr "vis rangering av bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:83
msgid ""
"True if a photo’s rating should be displayed as overlaid trinket, false "
"otherwise"
msgstr ""
"Sann viss rangeringa til eit bilete skal visast som eit overlagd merke, "
"usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:88
msgid "rating filter level"
msgstr "rangeringsfilternivå"

#: data/gsettings/org.gnome.shotwell.gschema.xml:89
msgid ""
"Determines how to filter photos based on their ratings. 1: Rejected or "
"better, 2: Unrated or better, 3: One or better, 4: Two or better, 5: Three "
"or better, 6: Four or better, 7: Five or better"
msgstr ""
"Avgjer korleis bilete skal filtrerast basert på rangeringa deira. 1: Avvist "
"eller betre, 2: Utan rangering eller betre, 3: Éin eller betre, 4: To eller "
"betre, 5: Tre eller betre, 6: Fire eller betre, 7: Fem eller betre"

#: data/gsettings/org.gnome.shotwell.gschema.xml:94
msgid "sort events ascending"
msgstr "sorter hendingar stigande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:95
msgid "True if events should be sorted ascending, false if descending"
msgstr "Sann viss hendingar skal sorterast stigande, usann viss søkkjande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:100
msgid "sort library photos ascending"
msgstr "sorter bibliotekbilete stigande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:101
msgid "True if library photos should be sorted ascending, false if descending"
msgstr ""
"Sann viss bibliotekbilete skal sorterast stigande, usann viss søkkjande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:106
msgid "sort library photos criteria"
msgstr "sorteringskriterium for bibliotekbilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:107
msgid ""
"A numeric code that specifies the sort criteria for photos in library views"
msgstr ""
"Ein numerisk kode som spesifiserer sorteringskriteriet for bilete i "
"bibliotekvisingar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:112
msgid "sort event photos ascending"
msgstr "sorter hendingsbilete stigande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:113
msgid "True if event photos should be sorted ascending, false if descending"
msgstr ""
"Sann viss hendingsbileta skal sorterast stigande, usann viss søkkjande"

#: data/gsettings/org.gnome.shotwell.gschema.xml:118
msgid "sort event photos criteria"
msgstr "sorter hendingsbilete etter kriterium"

#: data/gsettings/org.gnome.shotwell.gschema.xml:119
msgid "Specifies the sort criteria for event photos"
msgstr "Set sorteringskriteria for hendingsbilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:124
msgid "use 24 hour time"
msgstr "bruk 24-timars klokke"

#: data/gsettings/org.gnome.shotwell.gschema.xml:125
msgid ""
"True if should display times with a 24 hour clock, false if times should use "
"AM/PM notation"
msgstr ""
"Sann viss tidspunkt skal visast med 24-timars klokke, usann viss tidspunkt "
"skal bruke AM/PM-notasjon"

#: data/gsettings/org.gnome.shotwell.gschema.xml:130
msgid "keep relative time between photos"
msgstr "hald på relativ tid mellom bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:131
msgid ""
"True if when adjusting time/date of photos, relative time should be "
"maintained. False if all photos should be set to the same time"
msgstr ""
"Sann viss relativ tid skal behaldast når tid/dato for bileta vert justert. "
"Usann viss alle bileta skal setjast til same tid"

#: data/gsettings/org.gnome.shotwell.gschema.xml:136
msgid "modify original photo files"
msgstr "endre opphavlege biletfiler"

#: data/gsettings/org.gnome.shotwell.gschema.xml:137
msgid ""
"True if when adjusting time/date of photos, the original files should be "
"modified as well. False if changes are made only in the database"
msgstr ""
"Sann viss dei opphavlege filene også skal endrast når tid/dato for bileta "
"vert justert. Usann viss endringar berre vert gjorde i databasen"

#: data/gsettings/org.gnome.shotwell.gschema.xml:142
msgid "show welcome dialog on startup"
msgstr "vis velkomstvindauge ved oppstart"

#: data/gsettings/org.gnome.shotwell.gschema.xml:143
msgid ""
"True if, when on startup, a welcome dialog should be shown. False if it "
"should not be shown"
msgstr ""
"Sann viss ein velkomstdialog skal visast ved oppstart. Usann viss han ikkje "
"skal visast"

#: data/gsettings/org.gnome.shotwell.gschema.xml:148
msgid "sidebar position"
msgstr "plassering av sidefelt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:149
msgid "The width, in pixels, of the sidebar"
msgstr "Breidda, i pikslar, til sidefeltet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:154
msgid "photo thumbnail scale"
msgstr "skalering av miniatyrbilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:155
msgid "The scale of photo thumbnails, ranging from 72 to 360"
msgstr "Storleiken på bilete-miniatyrar, frå 72 til 360"

#: data/gsettings/org.gnome.shotwell.gschema.xml:160
msgid "pin toolbar state"
msgstr "tilstand for festa verktøylinje"

#: data/gsettings/org.gnome.shotwell.gschema.xml:161
msgid "Pin toolbar in fullscreen, or not"
msgstr "Fest verktøylinja i fullskjerm eller ikkje"

#: data/gsettings/org.gnome.shotwell.gschema.xml:166
msgid "prefer GTK+’s dark theme"
msgstr "vel GTK+ sitt mørke tema"

#: data/gsettings/org.gnome.shotwell.gschema.xml:167
msgid "Whether to use the dark theme of GTK+ for Shotwell or not"
msgstr "Om GTK+ sitt mørke tema skal brukast i Shotwell eller ikkje"

#: data/gsettings/org.gnome.shotwell.gschema.xml:172
msgid "background for transparent images"
msgstr "bakgrunn for gjennomsiktige bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:173
msgid "The background to use for transparent images"
msgstr "Bakgrunnen som skal brukast for gjennomsiktige bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:178
msgid "color for solid transparency background"
msgstr "farge for einfarga bakgrunn bak gjennomsiktige bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:179
msgid "Color to use if background for transparent images is set to solid color"
msgstr ""
"Farge som skal brukast som bakgrunn for gjennomsiktige bilete viss "
"bakgrunnen er sett til einfarga"

#: data/gsettings/org.gnome.shotwell.gschema.xml:184
msgid "Selection state of “hide photos” option"
msgstr "Val for «gøym bilete»"

#: data/gsettings/org.gnome.shotwell.gschema.xml:185
msgid ""
"Last used selection state of the “hide photos already imported” option in "
"the import page"
msgstr ""
"Sist brukte val for «gøym bilete som allereie er importerte» på importsida"

#: data/gsettings/org.gnome.shotwell.gschema.xml:192
msgid "duration"
msgstr "varigheit"

#: data/gsettings/org.gnome.shotwell.gschema.xml:193
msgid "The time (in seconds) to show each photo in the slideshow"
msgstr "Tida (i sekund) som kvart bilete vert vist i lysbiletframvisninga"

#: data/gsettings/org.gnome.shotwell.gschema.xml:198
msgid "transition duration"
msgstr "varigheit for overgang"

#: data/gsettings/org.gnome.shotwell.gschema.xml:199
msgid ""
"The time (in seconds) that a transition runs between photos in a slideshow"
msgstr ""
"Tida (i sekund) ein overgang mellom bilete varer i ei lysbiletframvisning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:204
msgid "transition effect id"
msgstr "ID for overgangseffekt"

#: data/gsettings/org.gnome.shotwell.gschema.xml:205
msgid ""
"The time (in seconds) to show each transition between photos in a slideshow"
msgstr ""
"Tida (i sekund) kvar overgang mellom bilete vert vist i ei "
"lysbiletframvisning"

#: data/gsettings/org.gnome.shotwell.gschema.xml:210
msgid "Show title"
msgstr "Vis tittel"

#: data/gsettings/org.gnome.shotwell.gschema.xml:211
msgid "Whether to show the title of a photo during the slideshow"
msgstr "Om tittelen til eit bilete skal visast under lysbiletframvisninga"

#: data/gsettings/org.gnome.shotwell.gschema.xml:216
#: data/ui/slideshow_settings.ui:75
msgid "Shuffle"
msgstr "Omstokking"

#: data/gsettings/org.gnome.shotwell.gschema.xml:217
msgid "Whether to shuffle the order of photos during the slideshow"
msgstr "Om rekkjefølgja på bileta skal stokkast under lysbiletframvisninga"

#: data/gsettings/org.gnome.shotwell.gschema.xml:224
msgid "maximize library window"
msgstr "maksimer bibliotekvindauget"

#: data/gsettings/org.gnome.shotwell.gschema.xml:225
msgid "True if library application is maximized, false otherwise"
msgstr "Sann viss appen til biblioteket er maksimert, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:230
msgid "width of library window"
msgstr "breidda på bibliotekvindauget"

#: data/gsettings/org.gnome.shotwell.gschema.xml:231
msgid "The last recorded width of the library application window"
msgstr "Breidda til det siste registrerte appvindauget til biblioteket"

#: data/gsettings/org.gnome.shotwell.gschema.xml:236
msgid "height of library window"
msgstr "høgda på bibliotekvindauget"

#: data/gsettings/org.gnome.shotwell.gschema.xml:237
msgid "The last recorded height of the library application window"
msgstr "Den siste registrerte høgda til appvindauget til biblioteket"

#: data/gsettings/org.gnome.shotwell.gschema.xml:242
msgid "maximize direct-edit window"
msgstr "maksimer vindauget for direkte redigering"

#: data/gsettings/org.gnome.shotwell.gschema.xml:243
msgid "True if direct-edit application is maximized, false otherwise"
msgstr "Sann viss direkte-redigeringsappen er maksimert, usann elles"

#: data/gsettings/org.gnome.shotwell.gschema.xml:248
msgid "width of direct-edit window"
msgstr "breidde på vindauget for direkte redigering"

#: data/gsettings/org.gnome.shotwell.gschema.xml:249
msgid "The last recorded width of the direct-edit application window"
msgstr ""
"Breidda som sist vart registrert for vindauget til appen for direkte "
"redigering"

#: data/gsettings/org.gnome.shotwell.gschema.xml:254
msgid "height of direct-edit window"
msgstr "høgda på vindauget for direkte redigering"

#: data/gsettings/org.gnome.shotwell.gschema.xml:255
msgid "The last recorded height of the direct-edit application window"
msgstr "Den siste registrerte høgda til vindauget for direkte redigering"

#: data/gsettings/org.gnome.shotwell.gschema.xml:260
msgid "sidebar divider position"
msgstr "posisjon for skiljet mellom sidefelt og vising"

#: data/gsettings/org.gnome.shotwell.gschema.xml:261
msgid ""
"The last recorded position of the divider between the sidebar and view in "
"library application window"
msgstr ""
"Den siste registrerte posisjonen for skiljet mellom sidefeltet og visinga i "
"bibliotekvindauget"

#: data/gsettings/org.gnome.shotwell.gschema.xml:268
msgid "import directory"
msgstr "importmappe"

#: data/gsettings/org.gnome.shotwell.gschema.xml:269
msgid "Directory in which imported photo files are placed"
msgstr "Mappe der importerte biletfiler vert plasserte"

#: data/gsettings/org.gnome.shotwell.gschema.xml:274
msgid "watch library directory for new files"
msgstr "overvak bibliotekmappa for nye filer"

#: data/gsettings/org.gnome.shotwell.gschema.xml:275
msgid ""
"If true, files added to the library directory are automatically imported"
msgstr ""
"Viss sant, vert filer som vert lagde til bibliotekmappa automatisk "
"importerte"

#: data/gsettings/org.gnome.shotwell.gschema.xml:280
msgid "write metadata to master files"
msgstr "skriv metadata til hovudfilene"

#: data/gsettings/org.gnome.shotwell.gschema.xml:281
msgid ""
"If true, changes to metadata (tags, titles, etc.) are written to the master "
"photo file"
msgstr ""
"Viss sant, vert endringar i metadata (merkelappar, titlar osv.) skrivne til "
"hovudbiletfila"

#: data/gsettings/org.gnome.shotwell.gschema.xml:286
msgid "use lowercase filenames"
msgstr "bruk små bokstavar i filnamn"

#: data/gsettings/org.gnome.shotwell.gschema.xml:287
msgid ""
"If true, Shotwell will convert all filenames to lowercase when importing "
"photo files"
msgstr ""
"Viss sant, vil Shotwell konvertere alle filnamn til små bokstavar når "
"biletfiler vert importerte"

#: data/gsettings/org.gnome.shotwell.gschema.xml:292
msgid "directory pattern"
msgstr "mappemønster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:293
msgid ""
"A string encoding a naming pattern that will be used to name photo "
"directories on import"
msgstr ""
"Ein streng som kodar eit namnemønster som skal brukast til å gje namn til "
"biletmappar ved import"

#: data/gsettings/org.gnome.shotwell.gschema.xml:298
msgid "directory pattern custom"
msgstr "tilpassa mappemønster"

#: data/gsettings/org.gnome.shotwell.gschema.xml:299
msgid ""
"A string encoding a custom naming pattern that will be used to name photo "
"directories on import"
msgstr ""
"Ein streng som kodar eit tilpassa namnemønster som skal brukast til å gje "
"namn til biletmappar ved import"

#: data/gsettings/org.gnome.shotwell.gschema.xml:304
msgid "RAW developer default"
msgstr "standard RAW-framkallar"

#: data/gsettings/org.gnome.shotwell.gschema.xml:305
msgid "Default option for which RAW developer Shotwell will use"
msgstr "Standardval for kva RAW-framkallar Shotwell skal bruke"

#: data/gsettings/org.gnome.shotwell.gschema.xml:312
msgid "Most-recently-used crop aspect ratio menu choice"
msgstr "Sist brukte val for sideforhold ved beskjæring"

#: data/gsettings/org.gnome.shotwell.gschema.xml:313
msgid "A numeric code representing the last crop menu choice the user made"
msgstr ""
"Ein numerisk kode som representerer det siste valet brukaren gjorde i "
"beskjæringsmenyen"

#: data/gsettings/org.gnome.shotwell.gschema.xml:317
msgid "Most-recently-used crop custom aspect ratio’s numerator"
msgstr "Teljar for sist brukte tilpassa sideforhold"

#: data/gsettings/org.gnome.shotwell.gschema.xml:318
msgid ""
"A nonzero, positive integer representing the width part of the last custom "
"crop ratio the user entered"
msgstr ""
"Eit positivt heiltal over null som representerer breiddedelen av det siste "
"tilpassa sideforholdet brukaren skreiv inn"

#: data/gsettings/org.gnome.shotwell.gschema.xml:322
msgid "Most-recently-used crop custom aspect ratio’s denominator"
msgstr "Nemnar for sist brukte tilpassa sideforhold"

#: data/gsettings/org.gnome.shotwell.gschema.xml:323
msgid ""
"A nonzero, positive integer representing the height part of the last custom "
"crop ratio the user entered"
msgstr ""
"Eit positivt heiltal over null som representerer høgdedelen av det siste "
"tilpassa sideforholdet brukaren skreiv inn"

#: data/gsettings/org.gnome.shotwell.gschema.xml:330
msgid "external photo editor"
msgstr "eksternt biletredigeringsprogram"

#: data/gsettings/org.gnome.shotwell.gschema.xml:331
msgid "External application used to edit photos"
msgstr "Eksternt program som vert brukt til å redigere bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:336
msgid "external raw editor"
msgstr "eksternt RAW-redigeringsprogram"

#: data/gsettings/org.gnome.shotwell.gschema.xml:337
msgid "External application used to edit RAW photos"
msgstr "Eksternt program som vert brukt til å redigere RAW-bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:379
#: data/gsettings/org.gnome.shotwell.gschema.xml:380
msgid "Setting in export dialog: how to trim images"
msgstr "Innstilling i eksportvindauget: korleis beskjære bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:385
msgid "export metadata"
msgstr "eksporter metadata"

#: data/gsettings/org.gnome.shotwell.gschema.xml:386
msgid "Setting in export dialog: option to export metadata"
msgstr "Innstilling i eksportvindauget: val for å eksportere metadata"

#: data/gsettings/org.gnome.shotwell.gschema.xml:391
msgid "format setting, special value"
msgstr "formatinnstilling, spesialverdi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:392
msgid "Setting in export dialog: format setting, special value"
msgstr "Innstilling i eksportvindauget: formatinnstilling, spesialverdi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:397
msgid "format setting, type value"
msgstr "formatinnstilling, typeverdi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:398
msgid "Setting in export dialog: format setting, type value"
msgstr "Innstilling i eksportvindauget: formatinnstilling, typeverdi"

#: data/gsettings/org.gnome.shotwell.gschema.xml:403
msgid "JPEG quality option"
msgstr "JPEG-kvalitet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:404
msgid "Setting in export dialog: jpeg quality option"
msgstr "Innstilling i eksportvindauget: JPEG-kvalitet"

#: data/gsettings/org.gnome.shotwell.gschema.xml:409
msgid "maximal size of image"
msgstr "maksimal storleik på bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:410
msgid "Setting in export dialog: maximal size of image"
msgstr "Innstilling i eksportvindauget: maksimal storleik på bilete"

#: data/gsettings/org.gnome.shotwell.gschema.xml:417
msgid "last used publishing service"
msgstr "sist brukte publiseringsteneste"

#: data/gsettings/org.gnome.shotwell.gschema.xml:418
#: data/gsettings/org.gnome.shotwell.gschema.xml:424
